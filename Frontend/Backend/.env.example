# ==============================================================================
# 🔑 CINEBOOK ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` in the same directory (`Frontend/Backend/.env`)
# and replace the values with your local MySQL database credentials.
# ==============================================================================

# Port number for the Express backend server (default: 5000)
PORT=5000

# MySQL Database Host (usually localhost or 127.0.0.1)
DB_HOST=localhost

# MySQL Database Username (default: root)
DB_USER=root

# MySQL Database Password
DB_PASSWORD=your_mysql_password_here

# Database Name (initialized via schema.sql)
DB_NAME=cinebook

# JSON Web Token (JWT) Secret Key used to cryptographically sign session tokens
JWT_SECRET=cinebook_super_secret_jwt_key_2026
